{
  "name": "microapp",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "description": "兴趣卡落地页空项目",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "build": "vibecoding build --target taro",
    "build:tt": "vibecoding turbo --target taro run build:tt:raw",
    "build:tt:raw": "vibecoding build --target taro --scope tt",
    "build:h5": "mkdir -p .home && HOME=$PWD/.home taro build --type h5",
    "build:server": "pnpm --filter server build:prod",
    "build:closed-domain-server": "if [ -f closed-domain-server/package.json ]; then pnpm --filter closed-domain-server build; else echo 'No closed-domain-server/package.json; skipping closed-domain-server build'; fi",
    "dev:server": "pnpm --filter server start:dev",
    "dev:closed-domain-server": "if [ -f closed-domain-server/package.json ]; then pnpm --filter closed-domain-server start:dev; else echo 'No closed-domain-server/package.json; skipping closed-domain-server dev'; fi",
    "dev:tt": "mkdir -p .home && HOME=$PWD/.home taro build --type tt --watch --mode dev",
    "dev:h5": "lsof -ti:10086 | xargs kill -9 2>/dev/null; NODE_OPTIONS='--max-old-space-size=6144' vibecoding dev-watch --target taro",
    "dev": "bash scripts/dev_run.sh",
    "lint": "vibecoding lint --target taro",
    "verify": "vibecoding verify --target taro --auto-start --full",
    "check-runtime-errors": "vibecoding verify --target taro --runtime-only",
    "check-routes": "vibecoding validate routes --target taro",
    "validate-feed-card": "vibecoding validate feed-card --target taro",
    "validate-feed-background": "vibecoding validate feed-background --target taro",
    "init-mysql-db": "vibecoding init-mysql-db --target taro",
    "postinstall": "weapp-tw patch"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@open-dy/lucide-taro": "^0.1.18",
    "@open-dy/vibecoding-sdk-taro": "^0.1.23",
    "@tarojs/components": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-tt": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.1",
    "@babel/preset-react": "^7.24.1",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.18.0",
    "@open-dy/vibecoding-cli": "^0.1.31",
    "@tailwindcss/postcss": "^4.2.1",
    "@tarojs/cli": "4.2.0",
    "@tarojs/plugin-inject": "4.2.0",
    "@tarojs/service": "4.2.0",
    "@tarojs/taro-loader": "4.2.0",
    "@tarojs/vite-runner": "4.2.0",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-preset-taro": "4.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.8",
    "react-refresh": "^0.14.2",
    "semver": "^7.7.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.5",
    "turbo": "^2.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^4.2.0",
    "weapp-tailwindcss": "4.11.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "weapp-tailwindcss"
    ],
    "packageExtensions": {
      "weapp-tailwindcss": {
        "dependencies": {
          "semver": "^7.7.2",
          "tailwindcss-patch": "^9.0.0"
        }
      }
    },
    "patchedDependencies": {
      "@weapp-tailwindcss/postcss@2.1.7": "patches/@weapp-tailwindcss__postcss@2.1.7.patch"
    },
    "overrides": {
      "@eslint/eslintrc>ajv": "^6.12.6",
      "clone-deep>is-plain-object": "^2.0.4",
      "@babel/helper-compilation-targets>lru-cache": "^6.0.0"
    }
  }
}
