{
  "name": "opencard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vibecoding-interest-card dev",
    "dev:h5": "NODE_OPTIONS='--max-old-space-size=6144' vibecoding-interest-card dev-watch",
    "dev:tt": "vibecoding-interest-card dev-tt",
    "build": "vibecoding turbo --target opencard run build:raw",
    "build:raw": "vibecoding-interest-card build",
    "build:pack": "vibecoding-interest-card pack",
    "lint": "vibecoding-interest-card lint"
  },
  "dependencies": {
    "@open-dy/vibecoding-sdk-opencard": "^0.1.24",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.8.0",
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.1",
    "@babel/preset-react": "^7.28.5",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@eslint/js": "^9.18.0",
    "@open-dy/vibecoding-cli": "^0.1.31",
    "@types/node": "^18.15.11",
    "@types/react": "^18.0.0",
    "eslint": "^9.18.0",
    "turbo": "^2.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@10.4.1"
}
